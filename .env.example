# Copy to .env (git-ignored) to customise. Every variable here is OPTIONAL.
# Vite exposes VITE_* variables to the browser bundle, so never put secrets or API keys in them.

# Time source for the live Delhi clock on /delhi.
# Leave empty to use the built-in public, keyless time APIs (timeapi.io, then worldtimeapi.org).
# If you set your own endpoint, it must allow CORS from your site and return either
#   { "unixtime": <seconds> } / { "utc_datetime": "<ISO>" }   (worldtimeapi style)  or
#   { "dateTime": "2026-10-29T15:42:07" } in Asia/Kolkata     (timeapi.io style).
# If every source fails, the clock falls back to the device clock and says so.
VITE_TIME_API_URL=
